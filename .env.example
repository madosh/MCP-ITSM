# Root .env — MCP server + Smithery
# Copy to .env: cp .env.example .env

# API key injected by Smithery at runtime (see smithery.yaml commandFunction)
API_KEY=your-smithery-api-key

# ── ServiceNow live adapter (optional) ────────────────────────────────────
# Leave all three unset to keep create_ticket/get_ticket/update_ticket/
# list_tickets/assign_ticket/add_comment running against the in-memory mock
# for system=servicenow. Set all three to route those calls to a real
# ServiceNow instance's Table API (incident table) instead.
SERVICENOW_BASE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# Optional: target a different table (default: incident)
# SERVICENOW_TABLE=incident
