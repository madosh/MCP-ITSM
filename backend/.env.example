# Backend .env — Express API
# Copy to .env: cp .env.example .env

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mcp-itsm

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1d

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── ITSM Integrations (all optional — leave blank for in-memory mock mode) ───

# ServiceNow
SERVICENOW_BASE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=

# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Zendesk
ZENDESK_BASE_URL=https://your-org.zendesk.com
ZENDESK_USERNAME=you@example.com
ZENDESK_TOKEN=

# Ivanti Neurons for ITSM
IVANTI_BASE_URL=https://your-instance.ivanti.com
IVANTI_CLIENT_ID=
IVANTI_CLIENT_SECRET=
IVANTI_TENANT_ID=

# Cherwell
CHERWELL_BASE_URL=https://your-instance.cherwell.com
CHERWELL_CLIENT_ID=
CHERWELL_AUTH_MODE=internal
CHERWELL_USERNAME=
CHERWELL_PASSWORD=

# ── MCP Context ───────────────────────────────────────────────────────────────
CONTEXT_DEFAULT_TTL=86400
CONTEXT_MAX_SIZE=1048576
