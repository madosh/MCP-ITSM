{
  "tools": [
    {
      "name": "create_ticket",
      "title": "Create Ticket",
      "description": "Create a new support ticket in the appropriate ITSM system",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the ticket"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the issue"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "default": "medium",
            "description": "Priority level of the ticket"
          },
          "system": {
            "type": "string",
            "enum": ["servicenow", "jira", "zendesk", "ivanti_neurons", "cherwell"],
            "default": "jira",
            "description": "ITSM system to create the ticket in"
          }
        },
        "required": ["title", "description"]
      }
    },
    {
      "name": "get_ticket",
      "title": "Get Ticket",
      "description": "Retrieve full details of an existing ticket by ID",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "description": "ID of the ticket to retrieve (e.g. JIRA-1000)"
          },
          "system": {
            "type": "string",
            "enum": ["servicenow", "jira", "zendesk", "ivanti_neurons", "cherwell"],
            "description": "ITSM system to retrieve the ticket from (optional)"
          }
        },
        "required": ["ticket_id"]
      }
    },
    {
      "name": "update_ticket",
      "title": "Update Ticket",
      "description": "Update the status, priority, or add a comment to an existing ticket",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "description": "ID of the ticket to update"
          },
          "status": {
            "type": "string",
            "enum": ["open", "in_progress", "resolved", "closed"],
            "description": "New status for the ticket"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "New priority level"
          },
          "comment": {
            "type": "string",
            "description": "Comment to add to the ticket"
          },
          "system": {
            "type": "string",
            "enum": ["servicenow", "jira", "zendesk", "ivanti_neurons", "cherwell"],
            "description": "ITSM system where the ticket exists (optional)"
          }
        },
        "required": ["ticket_id"]
      }
    },
    {
      "name": "list_tickets",
      "title": "List Tickets",
      "description": "List tickets with optional filtering by status, assignee, or system",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["open", "in_progress", "resolved", "closed", "all"],
            "description": "Filter tickets by status"
          },
          "assigned_to": {
            "type": "string",
            "description": "Filter tickets by assignee username"
          },
          "limit": {
            "type": "integer",
            "default": 10,
            "description": "Maximum number of tickets to return"
          },
          "system": {
            "type": "string",
            "enum": ["servicenow", "jira", "zendesk", "ivanti_neurons", "cherwell"],
            "description": "ITSM system to list tickets from (optional)"
          }
        }
      }
    },
    {
      "name": "assign_ticket",
      "title": "Assign Ticket",
      "description": "Assign a ticket to a specific user",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "description": "ID of the ticket to assign"
          },
          "user_id": {
            "type": "string",
            "description": "Username or ID of the user to assign to"
          },
          "system": {
            "type": "string",
            "enum": ["servicenow", "jira", "zendesk", "ivanti_neurons", "cherwell"],
            "description": "ITSM system where the ticket exists (optional)"
          }
        },
        "required": ["ticket_id", "user_id"]
      }
    },
    {
      "name": "add_comment",
      "title": "Add Comment",
      "description": "Add a comment (public or internal note) to an existing ticket",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "description": "ID of the ticket to comment on"
          },
          "comment": {
            "type": "string",
            "description": "Comment text to add"
          },
          "internal": {
            "type": "boolean",
            "default": false,
            "description": "True = internal note not visible to end users"
          },
          "system": {
            "type": "string",
            "enum": ["servicenow", "jira", "zendesk", "ivanti_neurons", "cherwell"],
            "description": "ITSM system where the ticket exists (optional)"
          }
        },
        "required": ["ticket_id", "comment"]
      }
    },
    {
      "name": "search_knowledge_base",
      "title": "Search Knowledge Base",
      "description": "Search knowledge base articles by keyword, error message, or topic",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query — keywords, error messages, or topic"
          },
          "limit": {
            "type": "integer",
            "default": 5,
            "description": "Maximum number of articles to return"
          },
          "system": {
            "type": "string",
            "enum": ["servicenow", "jira", "zendesk", "ivanti_neurons", "cherwell"],
            "description": "ITSM system knowledge base to search (optional)"
          }
        },
        "required": ["query"]
      }
    }
  ]
}
